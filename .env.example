# Agent
LLM_GATEWAY_V3_URL=http://localhost:8101

# MCP search. TAVILY_API_KEY is optional; when absent, web_search falls back to DDG.
TAVILY_API_KEY=

# Worker provider keys for llm_gatewayV3. Add at least one working provider.
GEMINI_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPEN_ROUTER_API_KEY=
GITHUB_ACCESS_TOKEN=

# Optional local worker.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# Gateway routing configuration.
LLM_ORDER=ollama,gemini,nvidia,groq,cerebras,openrouter,github
ROUTER_ORDER=cerebras,groq,nvidia,github
GATEWAY_V3_PORT=8101
